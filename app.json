{
  "expo": {
    "name": "Gently Reset",
    "slug": "gently-reset",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gentlyreset",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.gentlyreset.app",
      "config": {
        "usesNonExemptEncryption": false
      },
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF8EA",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF8EA",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-asset",
      "expo-video",
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.com.gentlyreset.app",
          "widgets": [
            {
              "name": "GentlyReset",
              "displayName": "Gently Reset",
              "description": "Your day, your streak and a little wave from the mascot.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryCircular",
                  "accessoryRectangular",
                  "accessoryInline"
                ]
              }
            }
          ]
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "gentlyreset",
          "project": "react-native",
          "url": "https://sentry.io/"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "com.gentlyreset.app.ExpoWidgetsTarget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.gentlyreset.app"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "0b47d509-32de-4921-a535-6da8d016f474"
      }
    }
  }
}
