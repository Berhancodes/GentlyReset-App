# Publishable client values only. Never put service-role or RevenueCat secret keys here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Test Store public SDK key starts with test_. Production App Store keys start with appl_.
EXPO_PUBLIC_REVENUECAT_API_KEY=

# Real https legal pages only. Leave blank until they exist.
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=

# Sentry crash reporting (public DSN, safe in the app). Release builds only.
EXPO_PUBLIC_SENTRY_DSN=

# Google sign-in (optional until set up): iOS and Web client IDs from Google Cloud.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
